{
  "name": "mcp-mgba",
  "version": "0.3.3",
  "description": "MCP server that bridges Claude to the mGBA Game Boy Advance emulator via Lua scripting",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-mgba": "dist/index.js",
    "mcp-mgba-vision": "dist/vision-index.js"
  },
  "files": [
    "dist/",
    "lua/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"import('node:fs').then(fs => { for (const p of ['dist/index.js', 'dist/vision-index.js']) fs.chmodSync(p, 0o755) })\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:vision": "node dist/vision-index.js",
    "prepare": "npm run build",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmang-dev/mcp-mgba.git"
  },
  "bugs": {
    "url": "https://github.com/dmang-dev/mcp-mgba/issues"
  },
  "homepage": "https://github.com/dmang-dev/mcp-mgba#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "fengari": "0.1.5",
    "typescript": "7.0.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mgba",
    "gba",
    "game-boy-advance",
    "emulator",
    "lua"
  ]
}
